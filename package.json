{
	"name": "@hagicode/steamworks.js",
	"description": "Node.js and Electron bindings for the Steamworks SDK: Steam Workshop, achievements, stats, cloud, overlay, networking.",
	"keywords": [
		"steam",
		"steamworks",
		"steamworks-sdk",
		"workshop",
		"ugc",
		"napi",
		"electron"
	],
	"homepage": "https://github.com/HagiCode-org/steamworks.js#readme",
	"bugs": {
		"url": "https://github.com/HagiCode-org/steamworks.js/issues"
	},
	"version": "0.0.1",
	"main": "index.js",
	"types": "index.d.ts",
	"napi": {
		"name": "steamworksjs",
		"triples": {
			"additional": [
				"x86_64-pc-windows-msvc",
				"x86_64-unknown-linux-gnu",
				"x86_64-apple-darwin",
				"aarch64-apple-darwin"
			]
		}
	},
	"files": [
		"dist/*",
		"index.js",
		"*.d.ts",
		"README.md"
	],
	"license": "MIT",
	"devDependencies": {
		"@napi-rs/cli": "2.18.4",
		"electron": "24.2.0",
		"rimraf": "6.0.1",
		"typescript": "5.5.3"
	},
	"dependencies": {
		"@types/node": "*"
	},
	"engines": {
		"node": ">= 14"
	},
	"scripts": {
		"build": "node build --release",
		"build:debug": "node build",
		"prune": "rimraf dist target client.d.ts",
		"format": "cargo clippy --fix --allow-staged && cargo fmt",
		"prepack": "node scripts/check-package.js",
		"test:offline": "node test/offline-smoke-test.js",
		"test:types": "cd test/typescript && pnpm run compile"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/HagiCode-org/steamworks.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@12.16.1"
}
